/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

# ── Tipo de centellador ───────────────────────────────────────────────────────
/scint/type BGO

# ── Fuente: TODO lo que llega al detector en Film_graphene ────────────────────
# Incluye: Alpha, Li7, gamma 478 keV (captura B-10),
#          gamma 4.44 MeV (Am-Be), neutrones dispersados, electrones, etc.
# Para usar solo captura B-10, reemplaza por /gun/inputFile y run.mac.
/gun/transmittedFile ../../Film_graphene/build/transmitted_particles_kaptonfirst.txt

/run/initialize

# Número de eventos = grupos (se cicla si pones más que los disponibles).
# Regenera transmitted_particles.txt con más neutrones en Film_graphene
# para tener más variedad sin repetición.
/run/beamOn 100000
