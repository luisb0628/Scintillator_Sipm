/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

# Generado automaticamente: corrida pareada con/sin grafeno, fuente Cs-137.
# Identico a run_gf.mac pero alimentado por el phase space de Cs-137 en vez
# de AmBe (ver Cs137PhaseSpace.root / run_cs137_g.mac en
# neutron-capture-graphene-boron-geant4). Util para caracterizar el fondo
# gamma de calibracion, no la fisica de captura de boro.

/scint/type BGO

/gun/inputFile ../../neutron-capture-graphene-boron-geant4/build/output_run_cs137_g.root
#/gun/ntuple ParticulasTransmitidas

# Numero de hilos: por defecto se usan todos los nucleos del equipo.
# Descomentar para fijarlo; debe ir antes de /run/initialize.
#/run/numberOfThreads 4

/run/initialize

/run/beamOn 2000000
