/control/verbose 2
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/run/initialize

# Visualización
/vis/open OGL
/vis/viewer/set/viewpointThetaPhi 30 30
/vis/viewer/set/style surface
/vis/viewer/set/autoRefresh true
/vis/scene/create
/vis/scene/add/volume
/vis/drawVolume
/vis/scene/add/trajectories smooth
/vis/scene/add/hits
/vis/scene/endOfEventAction accumulate

# Colores por tipo de partícula (incluye fotones ópticos)
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set gamma         yellow
/vis/modeling/trajectories/drawByParticleID-0/set e-            red
/vis/modeling/trajectories/drawByParticleID-0/set e+            blue
/vis/modeling/trajectories/drawByParticleID-0/set opticalphoton cyan
/vis/modeling/trajectories/drawByParticleID-0/set alpha         magenta
/vis/modeling/trajectories/drawByParticleID-0/set Li7           green

/vis/enable
/vis/viewer/refresh

# Decorations
/vis/set/textColour green
/vis/set/textLayout right
/vis/scene/add/text2D 0.5 -.9 24 ! ! Step 3 : Scintillator and Simp
/vis/set/textLayout
/vis/set/textColour

/vis/scene/add/axes -2.5 -2.5 0 5 cm

# Configuración del haz — gamma 662 keV (Cs-137) directamente frente al cristal
/gun/particle gamma
/gun/energy 662 keV
/gun/position 0 0 -1 mm
/gun/direction 0 0 1
/gun/number 1

# Simulación
/run/beamOn 1


