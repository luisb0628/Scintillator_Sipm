/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

# ═══════════════════════════════════════════════════════════════════════════════
#  Scintillator_SiPM — macro único de ejecución
#
#  Descomenta UNA opción en cada sección y ajusta los parámetros.
#  Luego ejecuta:  ./Scintillator_Sipm macros/run.mac
# ═══════════════════════════════════════════════════════════════════════════════

# ── Centellador ─────────────────────────────────────────────────────────────
# Opciones: PLASTIC | PLASTIC_B | BGO | CSI | LYSO
/scint/type BGO

# ── Fuente ──────────────────────────────────────────────────────────────────
#
# OPCIÓN A — Phase space desde output.root de Film_graphene (neutron-capture-graphene-boron-geant4):
#   /gun/ntuple selecciona el ntuple ("ParticulasTransmitidas" es el default, no hace falta declararlo)
#
# Señal pura de captura B-10 (secundarias nacidas en el grafeno):
#/gun/inputFile ../../neutron-capture-graphene-boron-geant4/build/output.root
#/gun/ntuple ProductosCaptura
#
# Espectro completo AmBe transmitido (todo lo que llega al detector):
# NOTA 2026-10: fuente AmBe separada (sin el gamma de 4.438 MeV del carbono).
/gun/inputFile ../../neutron-capture-graphene-boron-geant4/build/output_run_g.root
#/gun/ntuple ParticulasTransmitidas
#
# OPCIÓN B — Calibración gamma puntual (usa comandos estándar de G4ParticleGun):
#   Cs-137:
#/gun/particle gamma
#/gun/energy 661.7 keV
#/gun/position 0 0 -1 cm
#/gun/direction 0 0 1
#
# OPCIÓN C — Fuentes preset de calibración:
#   Cs137: gamma 661.7 keV (equivale a la Opción B)
#   Co60:  dos gammas en cascada  1173.2 + 1332.5 keV  (un par por evento)
#   Sr90:  espectro beta Sr-90/Y-90 en equilibrio secular  (un e- por evento)
#          50 % Sr-90 (Q = 0.546 MeV) + 50 % Y-90 (Q = 2.280 MeV)
#/gun/source Cs137
#/gun/source Co60
#/gun/source Sr90

# ────────────────────────────────────────────────────────────────────────────
/run/initialize

# ── Número de eventos ────────────────────────────────────────────────────────
# Calibración Cs-137 / Co-60:      100 000 – 500 000  (~5-25 min)
# Calibración Sr-90 beta:          500 000 – 1 000 000
# Phase space (ProductosCaptura):  usa el nº de grupos del ntuple (se cicla si pones más)
# Phase space (ParticulasTransmitidas): idem
/run/beamOn 100000
